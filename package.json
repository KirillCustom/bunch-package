{
  "name": "bunch-package",
  "version": "1.14.1",
  "description": "Patch management tool for Bun - alternative to patch-package",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "bunch-package": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun build index.ts --outfile=dist/index.js --target=bun",
    "test": "bun test",
    "prepublishOnly": "bun run build",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "bun",
    "patch",
    "npm",
    "postinstall",
    "dependency",
    "fix",
    "monkey-patch",
    "patch-package"
  ],
  "author": "Kirill Custom",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/KirillCustom/bunch-package.git"
  },
  "bugs": {
    "url": "https://github.com/KirillCustom/bunch-package/issues"
  },
  "homepage": "https://github.com/KirillCustom/bunch-package#readme",
  "engines": {
    "bun": ">=1.0.0"
  },
  "peerDependencies": {
    "bun": ">=1.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "typescript": "^7.0.2"
  }
}
